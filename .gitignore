# ==========================================
# Exceptions: demo samples used by the web console
# (must stay last so they override the media/samples rules above)
# ==========================================
!frontend/public/static/samples/
!frontend/public/static/samples/*
!docs/screenshots/
!docs/screenshots/*.png
!docs/report/images/
!docs/report/images/*.png
!docs/report/overleaf/images/
!docs/report/overleaf/images/*.png
# Frontend source lives in src/lib (the Python "lib/" rule above must not hide it)
!frontend/src/lib/
!frontend/src/lib/**
